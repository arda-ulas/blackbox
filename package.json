{
  "name": "@ardaulas/blackbox",
  "version": "0.2.2",
  "description": "A flight recorder for AI agents: record your Anthropic or OpenAI agent to a hash-chained cassette, replay it offline, fork it with one tool result changed, and diff to the first divergence.",
  "license": "MIT",
  "author": "Arda Ulas Ozdemir",
  "homepage": "https://arda-ulas.github.io/blackbox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arda-ulas/blackbox.git"
  },
  "bugs": {
    "url": "https://github.com/arda-ulas/blackbox/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-debugging",
    "llm",
    "anthropic",
    "openai",
    "record-replay",
    "cassette",
    "time-travel-debugger",
    "ci",
    "testing"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blackbox": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fixDeclarationImports.mjs && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "cli": "tsx src/cli.ts",
    "example:record": "tsx src/examples/record.ts",
    "example:replay": "tsx src/examples/replay.ts",
    "example:fork": "tsx src/examples/fork.ts",
    "fixtures:generate": "tsx scripts/generateFixtures.ts",
    "example:real-proof": "tsx src/examples/realRunProof.ts",
    "example:real-tooluse-proof": "tsx src/examples/realToolUseProof.ts",
    "example:real-fork-proof": "tsx src/examples/realForkProof.ts",
    "proof:anthropic": "npm run build && scripts/live-proof.sh anthropic",
    "proof:openai": "npm run build && scripts/live-proof.sh openai",
    "docs:cli": "tsx scripts/cliReference.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "tsx scripts/cliReference.ts --check && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@types/node": "^24.0.0",
    "openai": "^7.23.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  }
}
