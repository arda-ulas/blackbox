{
  "name": "@ardaulas/blackbox",
  "private": true,
  "version": "0.1.0",
  "description": "Local, offline-by-default time-travel debugger for AI agents: record, replay, fork, mutate, diff, verify, and assert single-agent tool-using runs from a canonically hash-chained cassette.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arda-ulas/blackbox.git"
  },
  "keywords": [
    "ai-agents",
    "time-travel-debugger",
    "cassette",
    "replay",
    "cli",
    "offline",
    "deterministic"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "blackbox": "bin/blackbox.js"
  },
  "files": [
    "bin",
    "src",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "example:record": "tsx src/examples/record.ts",
    "example:replay": "tsx src/examples/replay.ts",
    "example:fork": "tsx src/examples/fork.ts",
    "cli": "tsx src/cli.ts",
    "fixtures:generate": "tsx scripts/generateFixtures.ts",
    "example:real-proof": "tsx src/examples/realRunProof.ts",
    "example:real-tooluse-proof": "tsx src/examples/realToolUseProof.ts",
    "example:real-fork-proof": "tsx src/examples/realForkProof.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "tsx": "^4.23.0"
  }
}
